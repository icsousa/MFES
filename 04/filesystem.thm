<?xml version="1.0"?>
<alloy>

<view nodetheme="Martha" edgetheme="Martha" hideSkolem="yes">

<defaultnode/>

<defaultedge/>

<node>
   <type name="File"/>
   <type name="Int"/>
   <type name="String"/>
   <type name="univ"/>
   <type name="seq/Int"/>
   <set name="$someFile_o" type="Object"/>
</node>

<node color="Gray">
   <type name="Entry"/>
</node>

<node color="Red">
   <type name="Object"/>
</node>

<node hideunconnected="yes">
   <type name="Name"/>
</node>

<node shape="House">
   <set name="Root" type="Dir"/>
</node>

<node shape="Trapezoid">
   <type name="Dir"/>
</node>

<edge visible="no" attribute="yes">
   <relation name="has"> <type name="Entry"/> <type name="Name"/> </relation>
</edge>

</view>

</alloy>
